  <Import Project="$(NanoFrameworkProjectSystemPath)NFProjectSystem.props" Condition="Exists('$(NanoFrameworkProjectSystemPath)NFProjectSystem.props')" />
  <ItemGroup>
    <!--
      Core is hardware-free and is shared verbatim with Formicarium.Controller.Tests, which
      links these same files into a desktop test project. That is what allows the exact source
      that runs on the ESP32 to be exercised by a normal test runner.
    -->
    <Compile Include="Core\Actuation\IActuatorSet.cs" />
    <Compile Include="Core\Config\PinMap.cs" />
    <Compile Include="Core\Config\Setpoints.cs" />
