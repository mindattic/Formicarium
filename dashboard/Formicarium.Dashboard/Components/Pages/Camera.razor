@page "/camera"
@rendermode InteractiveServer
@inject FormicariumSettings Settings

<PageTitle>Formicarium — Camera</PageTitle>

<h1>Camera</h1>

@if (string.IsNullOrWhiteSpace(StreamUrl))
{
    <p class="lede">
        No camera configured. Set the stream URL (the MJPEG or snapshot URL of the IR-capable IP camera)
        in MindAttic Vault, then restart the dashboard.
    </p>
    <p>
        <button class="btn" @onclick="OpenCameraSetting">Open camera settings</button>
        @if (vaultMissing)
        {
            <span> MindAttic Vault isn't installed here; <a href="@CameraSettingLink">open it from this link</a> on the PC that has it.</span>
        }
    </p>

    <div class="chart">
        <h2 style="margin-top:0">Why an off-the-shelf IP camera</h2>
        <p class="lede" style="margin-bottom:0">
            .NET nanoFramework has no OV2640 driver — it is an open feature request with no library — so
            a camera board on the ESP32 would mean an Arduino C++ component in an otherwise all-C#
            project. An ONVIF or RTSP camera with built-in IR needs no firmware at all, and 850&nbsp;nm
            is invisible to the ants and to us, so the column can be watched through the night without
            lighting it.
        </p>
    </div>
}
else
{
    <p class="lede">
        Live view of the column. 850&nbsp;nm illumination is outside the ants' visible range, so night
        footage costs the colony nothing.
    </p>

    <div class="chart">
        <img src="@StreamUrl" alt="Formicarium camera" style="width:100%;height:auto;display:block;border-radius:4px" />
    </div>
}

@code {
    public const string StreamUrlSetting = "MindAttic:Settings:Formicarium:camera:streamUrl";
    private bool vaultMissing;

    private string? StreamUrl => Settings.Camera.StreamUrl;
    private static string CameraSettingLink => MindAttic.Vault.Launch.VaultSettings.Link(FormicariumSettings.AppId, StreamUrlSetting);

    // Runs server-side, on the PC hosting the dashboard, so it opens Vault.Desktop there over its local pipe.
    private void OpenCameraSetting() =>
        vaultMissing = !MindAttic.Vault.Launch.VaultSettings.Open(FormicariumSettings.AppId, StreamUrlSetting);
}
